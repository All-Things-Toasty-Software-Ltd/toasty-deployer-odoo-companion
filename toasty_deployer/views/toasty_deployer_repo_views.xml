<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone Repository List View -->
    <record id="toasty_deployer_repo_tree_view" model="ir.ui.view">
        <field name="name">toasty_deployer.repo.list</field>
        <field name="model">toasty_deployer.repo</field>
        <field name="arch" type="xml">
            <list string="Repositories">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="latest_status" widget="badge"
                       decoration-success="latest_status == 'success'"
                       decoration-danger="latest_status == 'failure'"
                       decoration-info="latest_status == 'running'"/>
                <field name="github_url" widget="url"/>
            </list>
        </field>
    </record>

    <!-- Repository Form View -->
    <record id="toasty_deployer_repo_form_view" model="ir.ui.view">
        <field name="name">toasty_deployer.repo.form</field>
        <field name="model">toasty_deployer.repo</field>
        <field name="arch" type="xml">
            <form string="Repository">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Repository Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="github_url" widget="url"/>
                        </group>
                        <group>
                            <field name="latest_status" widget="badge"
                                   decoration-success="latest_status == 'success'"
                                   decoration-danger="latest_status == 'failure'"
                                   decoration-info="latest_status == 'running'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deployment Runs" name="runs">
                            <field name="run_ids">
                                <list string="Deployment Runs" default_order="created_at desc">
                                    <field name="name" string="Run ID"/>
                                    <field name="commit_sha"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-danger="status == 'failure'"
                                           decoration-info="status == 'running'"/>
                                    <field name="created_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="toasty_deployer_repo_action" model="ir.actions.act_window">
        <field name="name">Repositories</field>
        <field name="res_model">toasty_deployer.repo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>