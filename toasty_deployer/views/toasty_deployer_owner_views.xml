<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Owner Form View -->
    <record id="toasty_deployer_form_view" model="ir.ui.view">
        <field name="name">toasty_deployer.owner.form</field>
        <field name="model">toasty_deployer.owner</field>
        <field name="arch" type="xml">
            <form string="Owner Dashboard">
                <sheet>
                    <div class="row">
                        <div class="col-md-3 border-end pe-3">
                            <div class="text-center mb-3">
                                <field name="avatar_image" widget="image" class="rounded-circle shadow-sm"
                                       style="max-width: 120px;"/>
                                <h3 class="mt-2">
                                    <field name="name" readonly="1"/>
                                </h3>
                                <field name="github_url" widget="url" string="GitHub Page"/>
                            </div>
                            <div class="text-muted small mt-3">
                                <label for="bio" string="Bio"/>
                                <field name="bio" readonly="1"/>
                            </div>
                        </div>

                        <div class="col-md-9 ps-4">
                            <h4 class="mb-3">Repositories</h4>
                            <!-- Use the list view as a reference instead of its own list. -->
                            <field name="repo_ids"
                                   context="{'list_view_ref': 'toasty_deployer.toasty_deployer_repo_tree_inline_view'}">
                                <list string="Repositories">
                                    <field name="name"/>
                                    <field name="latest_status" widget="badge"
                                           decoration-success="latest_status == 'success'"
                                           decoration-danger="latest_status == 'failure'"
                                           decoration-info="latest_status == 'running'"/>
                                    <field name="github_url" widget="url" string="Go To Repo"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Owner List View -->
    <record id="toasty_deployer_owner_tree_view" model="ir.ui.view">
        <field name="name">toasty_deployer.owner.list</field>
        <field name="model">toasty_deployer.owner</field>
        <field name="arch" type="xml">
            <list string="Owners">
                <field name="name"/>
                <field name="github_url" widget="url"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="toasty_deployer_owner_action" model="ir.actions.act_window">
        <field name="name">Owners + Repos</field>
        <field name="res_model">toasty_deployer.owner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>